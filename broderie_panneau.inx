<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Panneau de broderie</name>
    <id>org.pointlibre.broderie.panneau</id>
    <param name="port" type="string" gui-hidden="true"></param>
    <effect needs-live-preview="false">
        <object-type>all</object-type>
        <menu-tip>Réglages de broderie, aperçu, simulation, ordre, couleurs et export (moteur Ink/Stitch)</menu-tip>
        <effects-menu>
            <submenu name="Broderie"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">broderie_panneau.py</command>
    </script>
</inkscape-extension>
